  "calculationRules": {
    "currencyConversion": {
      "hungarianDisplay": "grossHUF = round(grossEUR × 400); netHUF = round(grossHUF / 1.20); vatHUF = grossHUF - netHUF",
      "canonicalCurrency": "EUR",
      "displayCurrency": "HUF",
      "fixedRate": 400,
      "noLiveRateSubstitution": true
    },
    "serviceFormulas": {
      "individualPortrait": {
        "formula": "packageGrossEUR + max(0, selectedRetouchedImages - 1) * retouchedImagePortraitGrossEUR",
        "exception": "headshotCvGross includes exactly one retouched image and does not allow additional automatic options."
      },
      "groupPortrait": {
        "formula": "groupSetupGrossEUR + people * groupPerPersonGrossEUR + people * max(0, retouchedImagesPerPerson - 1) * retouchedImageGroupGrossEUR + max(0, photographerCount - 1) * additionalPhotographerGrossEUR",
        "photographerCount": "ceil(people / (6 * selectedHours)), minimum 1"
      },
      "brandPhotography": {
        "formula": "packageGrossEUR + max(0, people * retouchedImagesPerPerson - 3) * retouchedImagePortraitGrossEUR",
        "includedRetouchedImagesTotalPerProject": 3
      },
      "fineArtPhotography": {
        "formula": "packageGrossEUR + max(0, selectedRetouchedImages - 2) * retouchedImageFineArtGrossEUR",
        "includedRetouchedImagesTotalPerProject": 2
      },
      "cLevelEventPhotography": {
        "formula": "packageGrossEUR + max(0, photographerCount - 1) * selectedHours * additionalPhotographerEventPerHourGrossEUR",
        "photographerCount": "1 + max(manualAdditionalPhotographers, parallelTracks - 1, ceil(guestCount / 250) - 1)",
        "deliveredImages": "The estimated delivered image count does not add per-image pricing. Standard event selection and colour correction are included."
      },
      "addOns": "Add the selected gross component prices. Immediate retouching is billed per started required hour.",
      "travel": {
        "austriaAndHungary": "ceil(crewMembers / 4) * travelPerVehicleGrossEUR",
        "otherCountries": "Custom quote required; excluded from the displayed orientation total."
      },
      "tax": {
        "displayedGrossIncludesAustrianVatPercent": 20,
        "netFormula": "round(gross / 1.20, 2)",
        "vatFormula": "round(gross - net, 2)",
        "euB2BOutsideAustria": "Continue displaying 20% Austrian VAT until company, VAT ID and legal eligibility have been verified."
      },
      "currencyConversion": {
        "hungarianDisplay": "grossHUF = round(grossEUR × 400); netHUF = round(grossHUF / 1.20); vatHUF = grossHUF - netHUF",
        "canonicalCurrency": "EUR",
        "displayCurrency": "HUF",
        "fixedRate": 400,
        "noLiveRateSubstitution": true
      }
    },
    "instruction": "Use the HUF component amounts directly or calculate the canonical EUR gross total and convert that gross total at exactly 400 HUF per EUR. Never substitute a live exchange rate."
