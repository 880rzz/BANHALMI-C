      "termsOfService": "https://www.norbertbanhalmi.com/terms-conditions/",
      "additionalProperty": [
        {"@type": "PropertyValue", "name": "Estimate status", "value": "Website and calculator amounts are non-binding preliminary estimates; the accepted written offer controls final scope and price."},
        {"@type": "PropertyValue", "name": "Booking payment", "value": "A booking payment applies only when the accepted written offer specifies one; no universal percentage is implied."},
        {"@type": "PropertyValue", "name": "Currency and VAT", "value": "The accepted written offer records currency, applicable VAT treatment and any verified cross-border tax treatment."},
        {"@type": "PropertyValue", "name": "Invoice plan", "value": "The accepted written offer records whether invoicing is single-stage or staged, the final invoice point and invoice payment deadlines."},
        {"@type": "PropertyValue", "name": "Overdue payment", "value": "An overdue agreed payment may pause production or final delivery, subject to the accepted agreement and applicable law."},
        {"@type": "PropertyValue", "name": "Additional costs", "value": "Additional work and third-party costs require written approval before invoicing unless already defined in the accepted agreement."},
        {"@type": "PropertyValue", "name": "Standard licence", "value": "Agreed final images may be used by the commissioning organisation on recorded channels, normally without time or territory limit unless the written offer states otherwise; copyright remains with the photographer."},
        {"@type": "PropertyValue", "name": "Approval", "value": "The client appoints one authorised decision-maker and consolidates multi-stakeholder feedback."},
        {"@type": "PropertyValue", "name": "Publication files", "value": "Only selected and approved final files are publication assets; previews, contact sheets, rejected frames and intermediate retouching files are not."},
        {"@type": "PropertyValue", "name": "Confidentiality", "value": "Unpublished portraits, internal events, strategic materials, contact sheets and project discussions are confidential by default."},
        {"@type": "PropertyValue", "name": "Portfolio permission", "value": "Delivery or payment does not automatically grant BANHALMI portfolio or reference rights; a separate permission or valid legal basis is required."},
        {"@type": "PropertyValue", "name": "Storage", "value": "Project files may be retained for a reasonable operational period, but permanent archive storage is not guaranteed and the client must back up delivered files."},
        {"@type": "PropertyValue", "name": "Deletion", "value": "Written deletion requests are handled where applicable, subject to contract, accounting, legal-claim and other valid retention duties."},
        {"@type": "PropertyValue", "name": "Studios", "value": "Vienna and Budapest are two active operational bases of one enterprise and one project system."},
        {"@type": "PropertyValue", "name": "Accessibility", "value": "The professional site supports visible keyboard focus, practical interaction targets, invalid-field visibility, reduced motion and forced colours."}
      ]
    },
